<!-- ============================================================= -->
<!-- SOC Home Lab - Regras de deteccao para o honeypot Cowrie       -->
<!-- Arquivo: /var/ossec/etc/rules/local_rules.xml                  -->
<!-- ============================================================= -->

<!-- ---------- Grupo base: login e comandos ---------- -->
<group name="cowrie,honeypot,">

  <rule id="100100" level="7">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.login.failed$</field>
    <description>Cowrie: falha de login de $(src_ip) com usuário $(username)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100101" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie: possível brute force vindo de $(src_ip)</description>
    <mitre><id>T1110.001</id></mitre>
  </rule>

  <rule id="100110" level="15">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.login.success$</field>
    <description>Cowrie: login bem-sucedido de $(src_ip) como $(username)</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <rule id="100120" level="15">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.command.input$</field>
    <description>Cowrie: comando executado no honeypot: $(input)</description>
    <mitre><id>T1059.004</id></mitre>
  </rule>

</group>

<!-- ---------- Grupo avancado: fases do ataque ---------- -->
<group name="cowrie,honeypot,avancado,">

  <!-- Filhas da 100120: classificam o comando por fase do ataque -->

  <rule id="100121" level="10">
    <if_sid>100120</if_sid>
    <field name="input">uname|whoami|/etc/passwd|ifconfig|hostname|cpuinfo</field>
    <description>Cowrie: reconhecimento do sistema: $(input)</description>
    <mitre><id>T1082</id></mitre>
  </rule>

  <rule id="100122" level="15">
    <if_sid>100120</if_sid>
    <field name="input">wget|curl|tftp</field>
    <description>Cowrie: download de ferramenta: $(input)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

  <rule id="100123" level="15">
    <if_sid>100120</if_sid>
    <field name="input">crontab|authorized_keys|rc.local</field>
    <description>Cowrie: tentativa de persistência: $(input)</description>
    <mitre><id>T1053.003</id><id>T1098.004</id></mitre>
  </rule>

  <rule id="100124" level="15">
    <if_sid>100120</if_sid>
    <field name="input">history -c|HISTFILE|/var/log|shred</field>
    <description>Cowrie: tentativa de apagar rastros: $(input)</description>
    <mitre><id>T1070.003</id><id>T1070.002</id></mitre>
  </rule>

  <!-- Outros eventos do Cowrie -->

  <rule id="100130" level="12">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.session.file_upload$</field>
    <description>Cowrie: arquivo enviado ao honeypot por $(src_ip): $(filename)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

  <rule id="100140" level="12">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.direct-tcpip.request$</field>
    <description>Cowrie: tentativa de túnel SSH para $(dst_ip):$(dst_port)</description>
    <mitre><id>T1572</id></mitre>
  </rule>

  <!-- Deteccao de scanner em dois niveis:                         -->
  <!-- 100150 alarma qualquer conexao (honeypot = tudo e suspeito) -->
  <!-- 100151 sobe o nivel quando reconhece uma ferramenta         -->

  <rule id="100150" level="5">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.client.version$</field>
    <description>Cowrie: nova conexão SSH de $(src_ip), cliente $(version)</description>
    <mitre><id>T1595</id></mitre>
  </rule>

  <rule id="100151" level="10">
    <if_sid>100150</if_sid>
    <field name="version" type="pcre2">(?i)(libssh|paramiko|nmap|go-|python|masscan|zgrab)</field>
    <description>Cowrie: ferramenta automatizada detectada: $(version)</description>
    <mitre><id>T1595</id></mitre>
  </rule>

</group>
